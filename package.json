{
  "name": "novambl",
  "description": "Mobile comic book reader app",
  "version": "0.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "cross-env EXPO_NO_DOTENV=1 expo start",
    "dev": "npx expo start --dev-client",
    "android": "cross-env EXPO_NO_DOTENV=1 expo run:android",
    "ios": "cross-env EXPO_NO_DOTENV=1 expo run:ios",
    "prebuild": "cross-env EXPO_NO_DOTENV=1 bun expo prebuild",
    "doctor": "npx expo-doctor@latest",
    "start:staging": "cross-env APP_ENV=staging bun run start",
    "prebuild:staging": "cross-env APP_ENV=staging bun run prebuild",
    "android:staging": "cross-env APP_ENV=staging bun run android",
    "ios:staging": "cross-env APP_ENV=staging bun run ios",
    "start:production": "cross-env APP_ENV=production bun run start",
    "prebuild:production": "cross-env APP_ENV=production bun run prebuild",
    "android:production": "cross-env APP_ENV=production bun run android",
    "ios:production": "cross-env APP_ENV=production bun run ios",
    "lint": "bunx @biomejs/biome check --only ./src",
    "db:generate": "bunx drizzle-kit generate"
  },
  "dependencies": {
    "@better-fetch/fetch": "^1.3.1",
    "@expo/config-plugins": "~56.0.0",
    "@expo/prebuild-config": "~56.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "@shopify/restyle": "^2.4.5",
    "@tanstack/react-query": "^5.101.4",
    "@types/react": "~19.2.17",
    "axios": "^1.18.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.22.0",
    "expo": "~56.0.19",
    "expo-constants": "~56.0.23",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.24",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.9",
    "expo-font": "~56.0.7",
    "expo-linking": "~56.0.16",
    "expo-router": "~56.2.18",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "iconsax-react-nativejs": "^0.0.8",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.8.3",
    "react-native-zip-archive": "^9.0.2",
    "react-query-kit": "^3.3.4",
    "typescript": "6.0.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@biomejs/biome": "^2.5.5",
    "babel-plugin-inline-import": "^3.0.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10"
  },
  "private": true,
  "trustedDependencies": ["@biomejs/biome", "@shopify/react-native-skia", "esbuild"]
}
